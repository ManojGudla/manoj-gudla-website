# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` for local development, and add the same
# variables in Vercel → Project → Settings → Environment Variables.
# Never commit real values. Variables starting with NEXT_PUBLIC_ are sent to
# the browser by design; everything else stays on the server.
# ─────────────────────────────────────────────────────────────────────────────

# The public address of the website, without a trailing slash.
# Use http://localhost:3000 locally. When you buy your domain, change this to
# e.g. https://yourdomain.com and redeploy — nothing else needs editing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase → Project Settings → API → service_role key.  SERVER ONLY.
# Used only to store contact-form messages. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# A long random string used to anonymise visitor IP addresses for rate limiting.
# Generate one with:  openssl rand -hex 32
IP_HASH_SALT=change-me-to-a-long-random-string

# ── Optional ────────────────────────────────────────────────────────────────
# Cloudflare Turnstile (free, privacy-friendly spam protection for the contact
# form). Leave empty to rely on the built-in honeypot + timing + rate limits.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email notification for new enquiries via Resend (https://resend.com).
# Leave empty to skip emails — enquiries are always saved to the dashboard.
RESEND_API_KEY=
ENQUIRY_NOTIFY_TO=manowj.tech@gmail.com
ENQUIRY_NOTIFY_FROM=Website <onboarding@resend.dev>
